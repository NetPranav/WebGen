# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# engine & wasm
wasm/dist/
wasm/tests/*_test
*.wasm
saved/
generated/

# export-harness fixtures (built per run; see tests/export-harness/build.mjs)
tests/export-harness/fixtures/*/node_modules/
tests/export-harness/fixtures/*/.next/
tests/export-harness/fixtures/*/out/
tests/export-harness/fixtures/*/dist/
tests/export-harness/fixtures/*/next-env.d.ts
tests/export-harness/fixtures/nextjs-app/tsconfig.json.bak
tests/export-harness/report/

# playwright
/playwright-report/
/test-results/
/blob-report/
