# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# engine & wasm (archived, ROADMAP decisions/0001-wasm.md: No-Go)
DOCS/Initial/decisions/0001-wasm-archive/dist/
DOCS/Initial/decisions/0001-wasm-archive/tests/*_test
DOCS/Initial/decisions/0001-wasm-archive/benchmark/*.wasm
DOCS/Initial/decisions/0001-wasm-archive/benchmark/engine.js
DOCS/Initial/decisions/0001-wasm-archive/benchmark/spline-solver.bundle.js
*.wasm
saved/
generated/

# export-harness fixtures (built per run; see tests/export-harness/build.mjs)
tests/export-harness/fixtures/*/node_modules/
tests/export-harness/fixtures/*/.next/
tests/export-harness/fixtures/*/out/
tests/export-harness/fixtures/*/dist/
tests/export-harness/fixtures/nextjs-app/tsconfig.json.bak
# next-env.d.ts is normally gitignored (line above) and auto-generated by
# `next dev`/`next build`, but the harness's own typecheck step runs before
# either of those ever run on a fresh checkout, so without it every
# *.module.css import fails to resolve (TS2307 — found via PR #7's first
# real CI run, AUD-43). This fixture's copy is static boilerplate, so it's
# committed instead.
!tests/export-harness/fixtures/nextjs-app/next-env.d.ts
tests/export-harness/report/

# playwright
/playwright-report/
/test-results/
/blob-report/
